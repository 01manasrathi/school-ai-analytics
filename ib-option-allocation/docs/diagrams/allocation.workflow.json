  "cards": [
    {
      "dot": "cyan",
      "title": "Only leftover seats",
      "items": [
        "Existing students are counted before the first new student is placed",
        "Blocks holding a preferred subject are solved first"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing fails silently",
      "items": [
        "A full block yields a waitlist slot flagged UNALLOCATED_SLOT",
