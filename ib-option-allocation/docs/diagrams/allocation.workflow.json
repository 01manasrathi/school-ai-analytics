{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "New Student Allocation — Run, Review, Commit",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "engine-pass",
        "label": "Engine pass",
        "focus": [
          "seats",
          "order",
          "search",
          "rulecheck"
        ],
        "note": "Existing students are already counted, so only leftover seats are offered."
      },
      {
        "id": "no-seat-branch",
        "label": "No seat branch",
        "focus": [
          "rulecheck",
          "waitlist"
        ],
        "note": "When every offering in a block is full the slot is waitlisted, not silently dropped."
      },
      {
        "id": "human-gate",
        "label": "Human gate",
        "focus": [
          "proposal",
          "review",
          "commit",
          "write"
        ],
        "note": "The proposal is a dry run; nothing is stored until the timetabler commits."
      }
    ]
  },
  "lanes": [
    {
      "id": "ui",
      "label": "Timetabler UI"
    },
    {
      "id": "engine",
      "label": "Allocation engine and persistence"
    },
    {
      "id": "rules",
      "label": "Rules and exceptions",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "prepare",
      "label": "Prepare",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "solve",
      "label": "Solve per student",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "confirm",
      "label": "Review and commit",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "run",
    "order",
    "search",
    "rulecheck",
    "proposal",
    "review",
    "commit",
    "write"
