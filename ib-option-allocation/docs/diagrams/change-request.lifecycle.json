  "cards": [
    {
      "dot": "emerald",
      "title": "Verdict is never cached",
      "items": [
        "Approve and override both re-run the feasibility engine first",
        "A waitlisted student keeps the current class until a seat frees up"
      ]
    },
    {
      "dot": "rose",
      "title": "Forcing has limits",
      "items": [
        "Override stores a reason of 5+ characters plus an audit row",
        "Block conflict, duplicate subject and period clash cannot be forced"
      ]
    }
  ]
