# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App → Settings → Secrets.
# Everything here is optional: without it the app uses a local SQLite file and a dev secret key.

# Persistent database. Streamlit Cloud containers are ephemeral, so SQLite data is lost on
# every restart. Point this at PostgreSQL (Neon, Supabase, RDS...) to keep data, and
# uncomment psycopg2-binary in requirements.txt.
# DATABASE_URL = "postgresql+psycopg2://user:password@host:5432/ib_options"

# Signs login tokens. Change it if anyone else can reach the deployment.
# SECRET_KEY = "put-a-long-random-string-here"
